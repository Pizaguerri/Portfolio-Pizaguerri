# .woodpecker.yml


pipeline:
  deploy:
    image: node:20-alpine
    secrets: [ cloudflare_api_token ]
    commands:
      - wget https://github.com/gohugoio/hugo/releases/download/v0.148.2/hugo_extended_0.148.2_Linux-64bit.tar.gz
      - tar -xzf hugo_extended_0.148.2_Linux-64bit.tar.gz
      - mv hugo /usr/local/bin/hugo
      - hugo version
      # Build the site
      - hugo --minify
      # Install wrangler and deploy
      - npm install -g wrangler
      - CLOUDFLARE_API_TOKEN=$CLOUDFLARE_API_TOKEN wrangler pages deploy public --project-name=portfoliopizaguerricodeberg --verbose